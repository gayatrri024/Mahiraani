// Mahiraani – Prisma Schema (SQLite for local dev; swap url for PostgreSQL in production)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Admin Auth ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products ProductCollection[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?
  status           String   @default("draft")
  isSample         Boolean  @default(false)

  basePrice        Int?
  comparePrice     Int?
  sku              String?
  stock            Int?     @default(0)
  lowStockThreshold Int?    @default(3)

  material         String?
  finish           String?
  dimensions       String?
  weight           String?
  closureType      String?
  careInstructions String?
  originDetails    String?
  packageContents  String?

  hasVariants      Boolean  @default(false)
  sizeOptions      String?
  colourOptions    String?

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  collections   ProductCollection[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([status])
  @@index([slug])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  variantImages VariantImage[]
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  options      String
  price        Int
  comparePrice Int?
  sku          String?
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images        VariantImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
}

model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageId   String
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime

  items CartItem[]
}

model CartItem {
  id             String          @id @default(cuid())
  cartId         String
  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPricePaise Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  token     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([token, productId])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id               String @id @default(cuid())
  reference        String @unique
  isTest           Boolean @default(true)

  customerName     String
  customerEmail    String
  customerPhone    String
  accessToken      String @unique @default(cuid())

  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  pincode          String
  country          String @default("India")

  subtotalPaise    Int
  shippingPaise    Int    @default(0)
  discountPaise    Int    @default(0)
  taxPaise         Int    @default(0)
  totalPaise       Int

  paymentStatus    String @default("pending")
  fulfilmentStatus String @default("unfulfilled")
  cancelReason     String?

  paymentProvider  String?
  paymentOrderId   String?
  paymentId        String?
  paymentSignature String?

  courierName      String?
  trackingNumber   String?
  trackingUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  OrderItem[]
  events OrderEvent[]
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  snapshotName        String
  snapshotVariantName String?
  snapshotSku         String?
  snapshotUnitPaise   Int
  quantity            Int

  createdAt DateTime @default(now())
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  note      String?
  createdAt DateTime @default(now())
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model InventoryLog {
  id        String          @id @default(cuid())
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  delta     Int
  reason    String
  note      String?
  createdAt DateTime        @default(now())
}

// ─── Store Config ─────────────────────────────────────────────────────────────

model StoreConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  payload     String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([entityType, entityId])
}
